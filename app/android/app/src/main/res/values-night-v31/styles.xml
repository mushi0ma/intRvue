<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: жүйелік splash API — Flutter логотипінің орнына intRvue белгісі. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_dark</item>
    </style>
</resources>
